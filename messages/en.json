  "faq": {
    "badge": "FAQ",
    "titleStart": "Still have",
    "titleAccent": "questions?",
    "subheadline": "We have prepared answers to the things our users ask most often.",
    "helpPrompt": "Still haven't found your answer?",
    "contactLink": "Contact the Upahku team",
    "items": [
      {
        "question": "What is Upahku?",
        "answer": "A platform that helps Indonesian informal workers turn completed jobs into verifiable reputation, so they earn fairer wages and land bigger jobs."
      },
      {
        "question": "How is proof of work verified so it cannot be faked?",
        "answer": "Every proof of work needs before/after photos, a date, a job type, and direct confirmation from the customer. The system also flags suspicious patterns such as reused photos."
      },
      {
        "question": "Who can give a Community Verification?",
        "answer": "Mandor, RT leaders, banjar leaders, shop owners, or anyone else who knows a person's work history directly in their community."
      },
      {
        "question": "Why doesn't my wage estimate show up?",
        "answer": "Wage estimates only appear when enough data is available for your city, job type, and experience combination. We never show a guessed number without real data."
      },
      {
        "question": "Can one good review boost my Trust Score?",
        "answer": "No. The Trust Score is designed so that no single source - one review, one verifier, or one customer - can dominate the number on its own."
      },
      {
        "question": "How do I register as a worker?",
        "answer": "Create an account, complete your basic profile (name, city, job type), then start recording your first job as proof of work."
      }
    ]
  },
